# Resend API key and verified sender address for real email delivery.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Required: the PostgreSQL provider's pooled connection URL. Never commit it.
# Hosted connections use certificate verification (sslmode=verify-full).
DATABASE_URL=
# Development only: outbox writes codes to private .data/outbox files.
SHELFIE_EMAIL_MODE=
# OpenAI vision API key for mandatory quality checks and label transcription.
LABEL_READER_API_KEY=
# Optional vision model override; default gpt-4.1-mini.
LABEL_READER_MODEL=
